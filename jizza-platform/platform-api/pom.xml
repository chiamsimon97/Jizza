<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.jizza</groupId><artifactId>jizza-platform</artifactId><version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath></parent>
  <artifactId>platform-api</artifactId>
  <name>Jizza :: web (REST + WS surface)</name>
  <dependencies>
    <dependency><groupId>com.jizza</groupId><artifactId>platform-usecases</artifactId></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-api</artifactId></dependency>
    <!--
      engine-security, engine-infra and engine-connectors are compile-scope: platform-api's
      controllers reach directly into a handful of their classes (CurrentUser, SessionCookies,
      StepUpInterceptor, PlatformProperties, ConnectorProperties) as cross-cutting infrastructure,
      the exception the boundary rule in ../pom.xml allows alongside engine-api. Everything else
      below is runtime-scope on purpose: platform-api's own code depends only on engine-api types
      for them, but Spring still needs the concrete beans on the classpath to wire the app, since
      jizza-app depends on nothing but platform-api.
    -->
    <dependency><groupId>com.jizza</groupId><artifactId>engine-security</artifactId></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-infra</artifactId></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-connectors</artifactId></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-persistence</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-agents</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-knowledge</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-memory</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-orchestrator</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-chat</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-connectors-tools</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-mcp</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-devices</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-scheduler</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-workflow</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-webauto</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-procedures</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-notifications</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-autonomy</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-websocket</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
  </dependencies>
</project>
