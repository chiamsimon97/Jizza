<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.jizza</groupId><artifactId>jizza-parent</artifactId><version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath></parent>
  <artifactId>jizza-platform</artifactId>
  <packaging>pom</packaging>
  <name>Jizza :: platform</name>
  <description>The entry point: every client call arrives here and the business logic lives here. Depends on engine-api only, so a use-case can ask the engine to act but can never reach inside it.</description>
  <modules>
    <module>platform-usecases</module>
    <module>platform-api</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>enforce-engine-api-boundary</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>false</searchTransitive>
                  <!--
                    searchTransitive=false: this only checks what platform-api itself declares, not
                    what engine-security/engine-infra pull in on their own (e.g. engine-persistence),
                    which is their business, not platform-api's. Only compile-scope engine-*
                    dependencies are banned. A runtime-scope one is fine:
                    Spring still needs the concrete module on the classpath to wire the app, since
                    jizza-app depends on nothing but platform-api, but platform-api's own code can't
                    have compiled against it, or it wouldn't be safe to demote to runtime in the
                    first place. engine-security and engine-infra are exempted outright: a handful of
                    their classes (CurrentUser, SessionCookies, StepUpInterceptor, PlatformProperties,
                    ConnectorProperties) are cross-cutting infrastructure, not business logic, and
                    forcing them through an engine-api port would add indirection without adding a
                    policy seam. See docs/REFACTOR-HANDOFF.md, Task B.
                  -->
                  <excludes>
                    <exclude>com.jizza:engine-*:*:*:compile</exclude>
                  </excludes>
                  <includes>
                    <include>com.jizza:engine-api</include>
                    <include>com.jizza:engine-security</include>
                    <include>com.jizza:engine-infra</include>
                    <include>com.jizza:engine-connectors</include>
                  </includes>
                  <message>jizza-platform may depend on engine-api at compile scope only (plus
engine-security/engine-infra/engine-connectors for cross-cutting session and config
infrastructure) -- reach the engine through its published ports, not a concrete engine module. See
docs/REFACTOR-HANDOFF.md, Task B.</message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
