<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>com.jizza</groupId><artifactId>jizza-engine</artifactId><version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath></parent>
  <artifactId>engine-mcp</artifactId>
  <name>Jizza :: MCP (tools served by Model Context Protocol servers)</name>
  <description>Offers the tools of the MCP servers the owner configured to the agents the owner named,
    through the Capability Registry like every other tool, so the kill switch, guardrails and audit
    log apply to them unchanged.</description>
  <dependencies>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-api</artifactId></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-persistence</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId></dependency>
    <!-- The core client with the Jackson 2 mapper, so it shares Spring Boot's Jackson. -->
    <dependency><groupId>io.modelcontextprotocol.sdk</groupId><artifactId>mcp-core</artifactId></dependency>
    <dependency><groupId>io.modelcontextprotocol.sdk</groupId><artifactId>mcp-json-jackson2</artifactId></dependency>
    <!-- Tests only: an MCP call through the real registry and guardrails. -->
    <dependency><groupId>com.jizza</groupId><artifactId>engine-agents</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.jizza</groupId><artifactId>engine-autonomy</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>
